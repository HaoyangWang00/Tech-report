\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{technicalreportstyle}[2026/09/01 Technical report style]

% 版式依据“研制报告_LaTeX”，仅负责页面、字体、标题、目录和图表样式。
\RequirePackage[a4paper,top=2.55cm,bottom=2.45cm,left=2.75cm,right=2.45cm,headheight=18pt,headsep=0.65cm,footskip=1.15cm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{setspace}
\RequirePackage{enumitem}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{caption}
\RequirePackage{float}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{etoolbox}

% 参考模板使用宋体、黑体和 Times New Roman；当前环境采用对应的 Noto 字体。
\setCJKmainfont{Noto Serif CJK SC}
\setCJKsansfont{Noto Sans CJK SC}
\setCJKfamilyfont{report-song}{Noto Serif CJK SC}
\setCJKfamilyfont{report-hei}{Noto Sans CJK SC}
\renewcommand{\songti}{\CJKfamily{report-song}}
\renewcommand{\heiti}{\CJKfamily{report-hei}}
\IfFontExistsTF{Times New Roman}{
  \setmainfont{Times New Roman}
}{
  \setmainfont{TeX Gyre Termes}
}

\definecolor{ReportRule}{HTML}{222222}

\hypersetup{
  colorlinks=false,
  pdfborder={0 0 0},
  bookmarksnumbered=true,
  bookmarksopen=true
}

\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\setstretch{1.50}
\setlist[itemize]{leftmargin=2.2em,itemsep=0.2em,topsep=0.3em}
\setlist[enumerate]{leftmargin=2.5em,itemsep=0.2em,topsep=0.3em}

% 将参考模板的“章—节—小节”视觉层级映射到现有的
% section—subsection—subsubsection，保持正文命令和编号不变。
\ctexset{
  section = {
    format = \heiti\zihao{3},
    beforeskip = 0pt,
    afterskip = 18pt
  },
  subsection = {
    format = \heiti\zihao{4},
    beforeskip = 16pt,
    afterskip = 8pt
  },
  subsubsection = {
    format = \heiti\zihao{-4},
    beforeskip = 12pt,
    afterskip = 5pt
  }
}

\titleformat{\section}[hang]
  {\heiti\zihao{3}}
  {\thesection}
  {1em}
  {}

\titleformat{\subsection}[hang]
  {\heiti\zihao{4}}
  {\thesubsection}
  {0.8em}
  {}

\titleformat{\subsubsection}[hang]
  {\heiti\zihao{-4}}
  {\thesubsubsection}
  {0.7em}
  {}

% 参考模板各章另起一页；在现有报告中由顶层 section 承担同一职责。
\pretocmd{\section}{\clearpage}{}{}

\fancypagestyle{reportpage}{%
  \fancyhf{}
  \fancyhead[L]{\songti\zihao{-5}\ReportHeaderLeft}
  \fancyhead[R]{\songti\zihao{-5}\ReportHeaderRight}
  \renewcommand{\headrulewidth}{0.45pt}
  \fancyfoot[C]{\zihao{-5}\thepage}
}

% ctex 在部分顶层标题页使用 plain，令其与参考模板的正文页保持一致。
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyhead[L]{\songti\zihao{-5}\ReportHeaderLeft}
  \fancyhead[R]{\songti\zihao{-5}\ReportHeaderRight}
  \renewcommand{\headrulewidth}{0.45pt}
  \fancyfoot[C]{\zihao{-5}\thepage}
}

\fancypagestyle{reportcover}{%
  \fancyhf{}
  \fancyhead[L]{\songti\zihao{-5}\ReportHeaderLeft}
  \fancyhead[R]{\songti\zihao{-5}\ReportHeaderRight}
  \renewcommand{\headrulewidth}{0.45pt}
}

\fancypagestyle{tocpage}{%
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
}

\pagestyle{reportpage}

\renewcommand{\contentsname}{目\quad 录}
\titlecontents{section}
  [0em]
  {\addvspace{0.35em}\songti\zihao{-4}}
  {\contentslabel{1.8em}}
  {}
  {\titlerule*[0.55pc]{.}\contentspage}
\titlecontents{subsection}
  [2.2em]
  {\songti\zihao{5}}
  {\contentslabel{2.8em}}
  {}
  {\titlerule*[0.55pc]{.}\contentspage}
\titlecontents{subsubsection}
  [5.1em]
  {\songti\zihao{-5}}
  {\contentslabel{3.7em}}
  {}
  {\titlerule*[0.55pc]{.}\contentspage}

\captionsetup{
  font={small},
  labelsep=quad,
  justification=centering,
  skip=6pt
}
\renewcommand{\figurename}{图}
\renewcommand{\tablename}{表}

\newcommand{\makeTechnicalReportCover}{%
  \clearpage
  \thispagestyle{reportcover}
  \begin{center}
    \vspace*{4.7cm}
    {\heiti\zihao{1}\parbox{0.90\textwidth}{\centering\ReportTitle}\par}
    \vspace{2.3cm}
    {\heiti\zihao{1}\ReportType\par}
    \vfill
    {\heiti\zihao{-3}完成单位\par}
    \vspace{0.5cm}
    {\heiti\zihao{3}\setstretch{1.35}\ReportUnits\par}
    \vspace{1.4cm}
    {\songti\zihao{3}\ReportDate\par}
    \vspace{1.0cm}
  \end{center}
  \clearpage
}
